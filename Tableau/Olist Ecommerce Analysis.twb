      <aliases enabled='yes' />
      <column caption='AVG Order Value' datatype='real' default-format='c&quot;R$&quot;#,##0;-&quot;R$&quot;#,##0' name='[Calculation_2647075173425152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_value]) / COUNTD([order_id])' />
      </column>
      <column caption='category name' datatype='string' name='[Calculation_2647075177426945]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER(LEFT(REPLACE([category], &quot;_&quot;, &quot; &quot;), 1))&#13;&#10;+ MID(REPLACE([category], &quot;_&quot;, &quot; &quot;), 2)' />
      </column>
      <column caption='Orders per Customer' datatype='integer' name='[Calculation_2647075212009474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [customer_unique_id] : COUNTD([order_id])}' />
      </column>
      <column caption='Repeat Rate' datatype='real' default-format='p0.0%' name='[Calculation_2647075212185603]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_2647075212009474] &gt; 1 THEN [customer_unique_id] END) / COUNTD([customer_unique_id])' />
      </column>
      <column caption='orders per customer AVG' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2647075215761412]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id]) / COUNTD([customer_unique_id])' />
      </column>
      <column caption='Late Rate' datatype='real' default-format='p0.0%' name='[Calculation_2647075234873349]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([late_flag])' />
      </column>
      <column caption='Review on Time' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2647075234996230]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [delivery_status] = &quot;On time&quot; THEN [review_score] END)' />
      </column>
      <column caption='Review Late' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_2647075235274759]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [delivery_status] = &quot;Late&quot; THEN [review_score] END)' />
      </column>
